# Proposed first-release environment contract. Integration owners must map and validate it.
NODE_ENV=development
BIND_HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=.local/collaboration.db
BACKUP_DIRECTORY=.local/backups

# Required secret in production. Leave blank here and inject through a secret manager.
AUTH_TOKEN_PEPPER=

# Private-by-default policy.
DEFAULT_SESSION_VISIBILITY=private
ALLOW_PUBLIC_SESSIONS=false
ALLOW_ANONYMOUS_ACCESS=false
INVITATION_TTL_MINUTES=60

# Browser and proxy boundary. Production requires HTTPS, secure cookies, and explicit origins.
TRUST_PROXY=false
TLS_TERMINATED_BY_PROXY=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Resource and retention defaults.
MAX_EVENT_BYTES=262144
MAX_ATTACHMENT_BYTES=10485760
REPLAY_PAGE_SIZE=250
CLOSED_SESSION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30

# Upload and logging policy.
UPLOAD_RAW_THINKING=false
UPLOAD_PRIVATE_INSTRUCTIONS=false
LOG_LEVEL=info
LOG_PAYLOADS=false
REDACT_KEYS=authorization,cookie,password,secret,token,access_token,refresh_token,api_key

# Contract E2E integration. Empty driver uses the in-memory reference implementation.
COLLAB_E2E_DRIVER=
E2E_SERVER_COMMAND=
E2E_HEALTH_URL=
E2E_STARTUP_TIMEOUT_MS=60000
