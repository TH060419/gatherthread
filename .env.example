# GatherThread owner-host environment contract.
# Copy to the ignored .env file. Generic HOST, PORT, and DATABASE_PATH variables are intentionally ignored.
NODE_ENV=development

# Public test deployment admission is separate from account/device credentials.
# Production MUST keep the default. See docs/TEST_ENVIRONMENT.md for isolated test configuration.
GATHERTHREAD_DEPLOYMENT_ENVIRONMENT=production
GATHERTHREAD_TEST_GATE_ENABLED=false
GATHERTHREAD_TEST_GATE_DATABASE_PATH=
GATHERTHREAD_TEST_GATE_PEPPER=

# The application always requires a loopback bind. LAN Caddy or Tailscale Serve provides HTTPS without opening this port.
GATHERTHREAD_SERVER_HOST=127.0.0.1
GATHERTHREAD_SERVER_PORT=18787
GATHERTHREAD_DATABASE_PATH=.local/collaboration.sqlite
GATHERTHREAD_STATIC_DIRECTORY=apps/web/dist

# Exact browser origin. Prefer the connection:* helpers documented in docs/CONNECTION_MODES.md.
# Production LAN uses a private https://...:8443 origin; Tailscale uses this device's exact https://*.ts.net origin.
GATHERTHREAD_PUBLIC_BASE_URL=http://127.0.0.1:18787
# Optional additional exact origins, comma-separated. Production entries must use HTTPS.
GATHERTHREAD_ALLOWED_ORIGINS=

# Every owner host requires at least 32 bytes so credentials survive process restarts.
# Leave blank for owner-host:init to generate a private value, or provide one through a secret manager. Never commit it.
GATHERTHREAD_AUTH_TOKEN_PEPPER=
GATHERTHREAD_TLS_TERMINATED_BY_PROXY=false

# Retired compatibility flag. Keep false; it cannot enable a user bootstrap route.
GATHERTHREAD_ALLOW_HTTP_BOOTSTRAP=false

# Event-storage safety limits. Raise deliberately if a trusted project needs more history.
GATHERTHREAD_MAX_EVENT_BYTES=262144
GATHERTHREAD_MAX_USER_EVENT_BYTES=268435456
GATHERTHREAD_MAX_SESSION_EVENT_BYTES=536870912
GATHERTHREAD_MAX_TOTAL_EVENT_BYTES=2147483648

# Session-row safety limits. Exact idempotent retries still succeed at the limit.
GATHERTHREAD_MAX_USER_SESSIONS=512
GATHERTHREAD_MAX_PROJECT_SESSIONS=2048
GATHERTHREAD_MAX_TOTAL_SESSIONS=8192

# Optional hosted trial Agent. Leave disabled until the Docker smoke test,
# immutable image digest, and provider compatibility are verified. See docs/HOSTED_AGENT.md.
GATHERTHREAD_HOSTED_AGENT_ENABLED=false
GATHERTHREAD_HOSTED_AGENT_FREE_PLAN_CONFIRMED=false
GATHERTHREAD_CLOUDFLARE_ACCOUNT_ID=
GATHERTHREAD_CLOUDFLARE_AI_TOKEN=
GATHERTHREAD_HOSTED_AGENT_IMAGE=
GATHERTHREAD_HOSTED_AGENT_ENDPOINTS=
GATHERTHREAD_HOSTED_AGENT_USER_DAILY_RUNS=1
GATHERTHREAD_HOSTED_AGENT_GLOBAL_DAILY_RUNS=4
GATHERTHREAD_HOSTED_AGENT_MAX_CONCURRENT=2
# limited is the default: equal RAM/RAM+swap caps, with no task swap.
# shared-host removes only container RAM/swap limits and requires host concurrency 1.
# It can exhaust shared-host resources. Review docs/HOSTED_AGENT.md before opting in.
GATHERTHREAD_HOSTED_AGENT_MEMORY_POLICY=limited
# These numeric settings apply only to limited mode; both remain strictly validated.
GATHERTHREAD_HOSTED_AGENT_MEMORY_MIB=768
GATHERTHREAD_HOSTED_GITHUB_MEMORY_MIB=2048
# For a reviewed rootless daemon, explicitly use its absolute local Unix socket.
# DOCKER_HOST=unix:///run/user/1001/docker.sock

# Separate Web preview only. The packaged owner host serves apps/web/dist itself.
GATHERTHREAD_WEB_HOST=127.0.0.1
GATHERTHREAD_WEB_PORT=4173
GATHERTHREAD_WEB_API_ORIGIN=http://127.0.0.1:18787
GATHERTHREAD_WEB_STATIC_DIRECTORY=dist

# Contract E2E integration. Empty driver uses the in-memory reference implementation.
COLLAB_E2E_DRIVER=
E2E_SERVER_COMMAND=
E2E_HEALTH_URL=
E2E_STARTUP_TIMEOUT_MS=60000

# Public email registration remains CLOSED by default. See docs/OPERATIONS.md before enabling.
# All dependencies are required; missing email/challenge configuration safely closes registration.
# There is no env-configurable mock mailer. Real providers require operator setup/consent.
GATHERTHREAD_PUBLIC_REGISTRATION=false
# Independent password recovery; configure the same Turnstile and Resend providers first.
GATHERTHREAD_PASSWORD_RECOVERY=false
GATHERTHREAD_REGISTRATION_FROM=
GATHERTHREAD_REGISTRATION_RESEND_KEY=
GATHERTHREAD_TURNSTILE_SITE_KEY=
GATHERTHREAD_TURNSTILE_SECRET=
# Optional exact socket peer IP. Edge must overwrite X-GatherThread-Client-IP, never trust client headers.
# Leave empty to share one conservative IP budget behind the proxy. X-Forwarded-For is ignored.
GATHERTHREAD_REGISTRATION_TRUSTED_PROXY=
