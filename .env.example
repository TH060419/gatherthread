# Relayroom owner-host environment contract.
# Copy to the ignored .env file. Generic HOST, PORT, and DATABASE_PATH variables are intentionally ignored.
NODE_ENV=development

# The application always requires a loopback bind. Tailscale Serve provides private HTTPS without opening this port.
ACP_SERVER_HOST=127.0.0.1
ACP_SERVER_PORT=8787
ACP_DATABASE_PATH=.local/collaboration.sqlite
ACP_STATIC_DIRECTORY=apps/web/dist

# Exact browser origin. In production use this device's https://*.ts.net Tailscale Serve origin.
ACP_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Optional additional exact origins, comma-separated. Production entries must use HTTPS.
ACP_ALLOWED_ORIGINS=

# Every owner host requires at least 32 bytes so credentials survive process restarts.
# Production additionally rejects obvious placeholders. Generate outside the repository and never commit it.
ACP_AUTH_TOKEN_PEPPER=
ACP_TLS_TERMINATED_BY_PROXY=false

# Keep false for owner-host deployments. Create the first owner with npm run owner-host:init.
ACP_ALLOW_HTTP_BOOTSTRAP=false

# Event-storage safety limits. Raise deliberately if a trusted project needs more history.
ACP_MAX_EVENT_BYTES=262144
ACP_MAX_USER_EVENT_BYTES=268435456
ACP_MAX_SESSION_EVENT_BYTES=536870912
ACP_MAX_TOTAL_EVENT_BYTES=2147483648

# Separate Web preview only. The packaged owner host serves apps/web/dist itself.
ACP_WEB_HOST=127.0.0.1
ACP_WEB_PORT=4173
ACP_WEB_API_ORIGIN=http://127.0.0.1:8787
ACP_WEB_STATIC_DIRECTORY=dist

# Contract E2E integration. Empty driver uses the in-memory reference implementation.
COLLAB_E2E_DRIVER=
E2E_SERVER_COMMAND=
E2E_HEALTH_URL=
E2E_STARTUP_TIMEOUT_MS=60000
