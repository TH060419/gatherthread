{
  "name": "gatherthread",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gatherthread",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/ws": "^8.18.1",
        "typescript": "^5.9.2"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "apps/server": {
      "name": "@gatherthread/server",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@gatherthread/protocol": "*",
        "ws": "^8.18.3",
        "zod": "^4.1.3"
      }
    },
    "apps/web": {
      "name": "@gatherthread/web",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@gatherthread/adapters": {
      "resolved": "packages/adapters",
      "link": true
    },
    "node_modules/@gatherthread/bridge": {
      "resolved": "packages/bridge",
      "link": true
    },
    "node_modules/@gatherthread/mcp": {
      "resolved": "packages/mcp",
      "link": true
    },
    "node_modules/@gatherthread/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@gatherthread/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@gatherthread/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "24.13.3",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": "~7.18.0"
      }
    },
    "node_modules/@types/ws": {
      "version": "8.18.1",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "@types/node": "*"
      }
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "7.18.2",
      "dev": true,
      "license": "MIT"
    },
    "node_modules/ws": {
      "version": "8.21.3",
      "license": "MIT",
      "engines": {
        "node": ">=10.0.0"
      },
      "peerDependencies": {
        "bufferutil": "^4.0.1",
        "utf-8-validate": ">=5.0.2"
      },
      "peerDependenciesMeta": {
        "bufferutil": {
          "optional": true
        },
        "utf-8-validate": {
          "optional": true
        }
      }
    },
    "node_modules/zod": {
      "version": "4.4.3",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/colinhacks"
      }
    },
    "packages/adapters": {
      "name": "@gatherthread/adapters",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "packages/bridge": {
      "name": "@gatherthread/bridge",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@gatherthread/adapters": "*"
      },
      "bin": {
        "gatherthread-bridge": "dist/src/cli.js",
        "gatherthread-codex": "dist/src/codex-connect.js",
        "gatherthread-codex-hook": "dist/src/codex-hook.js"
      }
    },
    "packages/mcp": {
      "name": "@gatherthread/mcp",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@gatherthread/adapters": "*",
        "@gatherthread/bridge": "*"
      },
      "bin": {
        "gatherthread-mcp": "dist/src/cli.js"
      }
    },
    "packages/protocol": {
      "name": "@gatherthread/protocol",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "zod": "^4.1.3"
      }
    }
  }
}
