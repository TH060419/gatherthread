[Unit]
Description=Prune unreachable GatherThread cloud Git objects
ConditionPathIsDirectory=/var/lib/gatherthread/collaboration.sqlite.code

[Service]
Type=oneshot
User=gatherthread
Group=gatherthread
WorkingDirectory=/opt/gatherthread/current
ExecStart=/usr/bin/flock -x -w 120 /var/lib/gatherthread/collaboration.sqlite.code/.maintenance.lock /usr/local/bin/node /opt/gatherthread/current/scripts/prune-code-objects.mjs /var/lib/gatherthread/collaboration.sqlite
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gatherthread
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
