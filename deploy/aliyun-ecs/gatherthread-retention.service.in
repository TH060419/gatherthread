[Unit]
Description=Prune expired GatherThread private backup sets

[Service]
Type=oneshot
User=gatherthread
Group=gatherthread
WorkingDirectory=/opt/gatherthread/current
ExecStart=/opt/gatherthread/current/scripts/prune-sqlite-backups.sh /var/backups/gatherthread
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/gatherthread
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
