[Unit]
Description=Back up only GatherThread test databases and Git objects
After=gatherthread-test.service

[Service]
Type=oneshot
User=gatherthread-test
Group=gatherthread-test
WorkingDirectory=/opt/gatherthread-test/current
ExecStart=/opt/gatherthread-test/current/scripts/backup-sqlite.sh /var/lib/gatherthread-test/collaboration.sqlite /var/backups/gatherthread-test
ExecStart=/opt/gatherthread-test/current/scripts/test-environment/backup-admission.sh
ExecStartPost=/opt/gatherthread-test/current/scripts/prune-sqlite-backups.sh /var/backups/gatherthread-test
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gatherthread-test /var/backups/gatherthread-test
InaccessiblePaths=-/etc/gatherthread -/var/lib/gatherthread -/var/backups/gatherthread -/opt/gatherthread
CPUQuota=25%
MemoryMax=256M
