# Only the server-management chat installs this template, after review.
NODE_ENV=production
GATHERTHREAD_DEPLOYMENT_ENVIRONMENT=test
GATHERTHREAD_TEST_GATE_ENABLED=true
GATHERTHREAD_SERVER_HOST=127.0.0.1
GATHERTHREAD_SERVER_PORT=28787
GATHERTHREAD_PUBLIC_BASE_URL=https://test.gatherthread.cn
GATHERTHREAD_ALLOWED_ORIGINS=https://test.gatherthread.cn
GATHERTHREAD_TLS_TERMINATED_BY_PROXY=true
GATHERTHREAD_ALLOW_HTTP_BOOTSTRAP=false
GATHERTHREAD_DATABASE_PATH=/var/lib/gatherthread-test/collaboration.sqlite
GATHERTHREAD_STATIC_DIRECTORY=/opt/gatherthread-test/current/apps/web/dist
GATHERTHREAD_TEST_GATE_DATABASE_PATH=/var/lib/gatherthread-test/admission.sqlite
GATHERTHREAD_AUTH_TOKEN_PEPPER=
GATHERTHREAD_TEST_GATE_PEPPER=
# PR62 dependency: remain closed until the merged candidate and providers pass review.
GATHERTHREAD_PUBLIC_REGISTRATION=false
GATHERTHREAD_PASSWORD_RECOVERY=false
GATHERTHREAD_REGISTRATION_TRUSTED_PROXY=127.0.0.1
GATHERTHREAD_TURNSTILE_SITE_KEY=
GATHERTHREAD_TURNSTILE_SECRET=
GATHERTHREAD_REGISTRATION_RESEND_KEY=
GATHERTHREAD_REGISTRATION_FROM=
# Limits fit within this deployment's own budget. Separate disk quota is also required.
GATHERTHREAD_MAX_USER_EVENT_BYTES=33554432
GATHERTHREAD_MAX_SESSION_EVENT_BYTES=67108864
GATHERTHREAD_MAX_TOTAL_EVENT_BYTES=134217728
GATHERTHREAD_MAX_USER_SESSIONS=64
GATHERTHREAD_MAX_PROJECT_SESSIONS=128
GATHERTHREAD_MAX_TOTAL_SESSIONS=256
