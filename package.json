{
  "name": "gatherthread",
  "version": "0.1.0-alpha.5",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:dsh-plugin && npm run build:connector && npm run build:web",
    "build:ts": "tsc -b",
    "build:dsh-plugin": "node scripts/build-dsh-plugin.mjs",
    "build:connector": "npm --workspace @gatherthread/codex-connect run build",
    "build:web": "npm --workspace apps/web run build",
    "clean": "tsc -b --clean",
    "start": "node apps/server/dist/src/cli.js start",
    "owner-host": "node --env-file-if-exists=.env scripts/self-host.mjs start",
    "owner-host:init": "node --env-file-if-exists=.env scripts/self-host.mjs init",
    "connection:local": "node scripts/configure-connection.mjs local",
    "connection:lan": "node scripts/configure-connection.mjs lan",
    "connection:tailscale": "node scripts/configure-connection.mjs tailscale",
    "lan:start": "node scripts/lan-start.mjs",
    "owner-host:lan": "node --env-file-if-exists=.env scripts/self-host-lan.mjs",
    "owner-host:tailscale-serve": "node --env-file-if-exists=.env scripts/self-host-tailscale.mjs",
    "codex:connect": "npm run build:ts && node packages/bridge/dist/src/codex-connect-bin.js",
    "dsh:connect": "npm run build:ts && node packages/dsh-host/dist/src/connect-cli.js",
    "zcode:connect": "npm run build:ts && node packages/bridge/dist/src/zcode-connect.js",
    "test": "npm run test:unit && npm run test:scripts && npm run test:web && npm run test:integration && npm run test:e2e",
    "test:unit": "npm run build:ts && node --test packages/protocol/dist/test/*.test.js packages/adapters/dist/test/*.test.js packages/bridge/dist/test/*.test.js packages/dsh-host/dist/test/*.test.js packages/mcp/dist/test/*.test.js apps/server/dist/test/*.test.js",
    "test:scripts": "npm run build:connector && node --test scripts/test/*.test.mjs",
    "test:web": "npm --workspace apps/web run check",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:dsh-host:real": "npm run build:ts && node scripts/test-dsh-host-real.mjs",
    "test:dsh-connect:real": "npm run build:ts && node scripts/test-dsh-connect-real.mjs",
    "test:dsh-npm-plugin:real": "npm run build && node scripts/test-dsh-npm-plugin-real.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc -b --pretty false",
    "audit:references": "node scripts/check-references.mjs",
    "audit:licenses": "node scripts/check-dependency-licenses.mjs",
    "audit:branding": "node scripts/check-branding.mjs",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "audit:vulnerabilities": "npm audit --audit-level=moderate",
    "release:archive": "node scripts/package-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:verify-codex": "node scripts/verify-codex-package.mjs",
    "release:verify-dsh": "node scripts/verify-dsh-package.mjs",
    "release:verify-zcode": "node scripts/verify-zcode-package.mjs",
    "release:pack-npm": "node scripts/pack-npm-release.mjs",
    "release:dry-run-npm": "node scripts/dry-run-npm-release.mjs",
    "release:verify": "npm run verify && npm run release:check && npm run release:verify-codex && npm run release:verify-dsh && npm run release:verify-zcode",
    "test:zcode-connect:real": "npm run build:ts && node scripts/test-zcode-connect-real.mjs",
    "verify": "npm run typecheck && npm run build:dsh-plugin && npm run build:web && npm run test && npm run audit:references && npm run audit:licenses && npm run audit:branding && npm run audit:secrets && npm run audit:vulnerabilities"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
