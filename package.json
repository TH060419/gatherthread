{
  "name": "gatherthread",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:web",
    "build:ts": "tsc -b",
    "build:web": "npm --workspace apps/web run build",
    "clean": "tsc -b --clean",
    "start": "node apps/server/dist/src/cli.js start",
    "owner-host": "node --env-file-if-exists=.env scripts/self-host.mjs start",
    "owner-host:init": "node --env-file-if-exists=.env scripts/self-host.mjs init",
    "owner-host:tailscale-serve": "node --env-file-if-exists=.env scripts/self-host-tailscale.mjs",
    "codex:connect": "npm run build:ts && node packages/bridge/dist/src/codex-connect.js",
    "test": "npm run test:unit && npm run test:scripts && npm run test:web && npm run test:integration && npm run test:e2e",
    "test:unit": "npm run build:ts && node --test packages/protocol/dist/test/*.test.js packages/adapters/dist/test/*.test.js packages/bridge/dist/test/*.test.js packages/mcp/dist/test/*.test.js apps/server/dist/test/*.test.js",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:web": "npm --workspace apps/web run check",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc -b --pretty false",
    "audit:references": "node scripts/check-references.mjs",
    "audit:licenses": "node scripts/check-dependency-licenses.mjs",
    "audit:branding": "node scripts/check-branding.mjs",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "audit:vulnerabilities": "npm audit --audit-level=moderate",
    "verify": "npm run typecheck && npm run build:web && npm run test && npm run audit:references && npm run audit:licenses && npm run audit:branding && npm run audit:secrets && npm run audit:vulnerabilities"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
