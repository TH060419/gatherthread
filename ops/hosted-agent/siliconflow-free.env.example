# Copy into the private server environment; never commit the filled copy.
# Beta exposes the Web entry; this template does not activate the server runner.
GATHERTHREAD_HOSTED_AGENT_ENABLED=false
GATHERTHREAD_HOSTED_AGENT_PRESET=siliconflow-free
GATHERTHREAD_HOSTED_AGENT_IMAGE=
GATHERTHREAD_SILICONFLOW_API_KEY=
# Optional JSON subset of the reviewed zero-price, tool-capable models.
# Omit to select all six candidates; enable only models validated on this account.
# Stable catalog order keeps Qwen3.5-4B the default when selected.
# GATHERTHREAD_SILICONFLOW_FREE_MODELS='["Qwen/Qwen3.5-4B","Qwen/Qwen3-8B","Qwen/Qwen2.5-7B-Instruct","THUDM/GLM-4-9B-0414","THUDM/GLM-Z1-9B-0414","XingChenAGI/Xing4.0-29B"]'
# Set true only after confirming every selected model's input/output prices are zero,
# tool calls work, and the account is eligible to serve GatherThread's users.
GATHERTHREAD_HOSTED_AGENT_FREE_PLAN_CONFIRMED=false
# One user: one active task and at least 30 seconds between accepted starts.
GATHERTHREAD_HOSTED_AGENT_USER_MIN_INTERVAL_SECONDS=30
GATHERTHREAD_HOSTED_AGENT_USER_MAX_CONCURRENT=1
# Host/account capacity, shared by all selected models. Size this for the deployment host.
GATHERTHREAD_HOSTED_AGENT_MAX_CONCURRENT=2
# Default limited RAM/swap. shared-host is a separate reviewed operator opt-in,
# requires max concurrency 1, and needs matching host cgroup settings and runner image.
GATHERTHREAD_HOSTED_AGENT_MEMORY_POLICY=limited
# The free preset defaults to no daily user/global run allowance.
# Do not retain daily-run or legacy Neuron overrides from an earlier deployment.
